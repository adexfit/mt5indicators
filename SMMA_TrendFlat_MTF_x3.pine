//@version=6
// SMMA_TrendFlat_MTF_x3 - three stacked SMMA_TrendFlat_MTF instances in one
// pane. Each row is an independent multi-timeframe trend with its own
// selectable timeframe, drawn as a colored flat line with flip arrows.
//   Row 1 = top, Row 2 = middle, Row 3 = bottom.
//
// Engine per row is identical to SMMA_TrendFlat_MTF.pine:
//   - SMMA(High) & SMMA(Low), period `smmaPeriod` (ta.rma == MODE_SMMA)
//   - green candle closing > SMMA(High)+thr -> trend green
//   - red candle closing  < SMMA(Low)-thr   -> trend red, else hold
//   - arrows on flips; no repaint (confirmed HTF bar via [1] + lookahead_off)
indicator("SMMA Flat Trend MTF x3", "SMMA Flat x3", overlay = false)

// ---------------- Inputs ----------------
tf1 = input.timeframe("240", "Row 1 TF (top)",    group = "Timeframes")
tf2 = input.timeframe("60",  "Row 2 TF (middle)", group = "Timeframes")
tf3 = input.timeframe("15",  "Row 3 TF (bottom)", group = "Timeframes")

smmaPeriod   = input.int(5,    "SMMA Period (High & Low)", minval = 1,   group = "Trend")
minBreakPips = input.float(0.0,"Min Break (pips) beyond SMMA", minval = 0.0, step = 0.1, group = "Trend")
showArrows   = input.bool(true,"Show Flip Arrows", group = "Display")
arrowGap     = input.float(0.25,"Arrow Gap from Line", minval = 0.0, maxval = 0.45, group = "Display")

// ---------------- Pip size (digits-aware) ----------------
digits = int(math.round(-math.log10(syminfo.mintick)))
pip    = (digits == 3 or digits == 5) ? syminfo.mintick * 10 : syminfo.mintick
thr    = minBreakPips * pip

tfSecChart = timeframe.in_seconds(timeframe.period)

// ---------------- Shared trend engine (runs in each HTF context) --------
htfTrend() =>
    smmaHigh = ta.rma(high, smmaPeriod)
    smmaLow  = ta.rma(low,  smmaPeriod)
    green = close > open
    red   = close < open
    bull  = green and not na(smmaHigh) and close > smmaHigh + thr
    bear  = red   and not na(smmaLow)  and close < smmaLow  - thr
    var int t = 0
    if bull
        t := 1
    else if bear
        t := -1
    t

// Clamp any TF lower than the chart TF up to the chart TF
f_clamp(tf) => timeframe.in_seconds(tf) < tfSecChart ? timeframe.period : tf
useTF1 = f_clamp(tf1)
useTF2 = f_clamp(tf2)
useTF3 = f_clamp(tf3)

// No-repaint MTF read: confirmed HTF bar via [1] + lookahead_off
trend1 = request.security(syminfo.tickerid, useTF1, htfTrend()[1], lookahead = barmerge.lookahead_off)
trend2 = request.security(syminfo.tickerid, useTF2, htfTrend()[1], lookahead = barmerge.lookahead_off)
trend3 = request.security(syminfo.tickerid, useTF3, htfTrend()[1], lookahead = barmerge.lookahead_off)

// ---------------- Stacked levels ----------------
level1 = 3.0
level2 = 2.0
level3 = 1.0

col(t) => t == 1 ? color.lime : t == -1 ? color.red : color.gray

// Invisible anchors keep the vertical scale (and line spacing) stable
plot(level1 + 0.7, "top_anchor", color = color.new(color.gray, 100))
plot(level3 - 0.7, "bot_anchor", color = color.new(color.gray, 100))

// Trend lines
plot(level1, "Row 1", color = col(trend1), linewidth = 3)
plot(level2, "Row 2", color = col(trend2), linewidth = 3)
plot(level3, "Row 3", color = col(trend3), linewidth = 3)

// ---------------- Flip arrows (green below line, red above line) ----------
f1u = trend1 ==  1 and trend1[1] !=  1
f1d = trend1 == -1 and trend1[1] != -1
f2u = trend2 ==  1 and trend2[1] !=  1
f2d = trend2 == -1 and trend2[1] != -1
f3u = trend3 ==  1 and trend3[1] !=  1
f3d = trend3 == -1 and trend3[1] != -1

plotshape(showArrows and f1u ? level1 - arrowGap : na, "R1 up", shape.triangleup,   location.absolute, color.lime, size = size.tiny)
plotshape(showArrows and f1d ? level1 + arrowGap : na, "R1 dn", shape.triangledown, location.absolute, color.red,  size = size.tiny)
plotshape(showArrows and f2u ? level2 - arrowGap : na, "R2 up", shape.triangleup,   location.absolute, color.lime, size = size.tiny)
plotshape(showArrows and f2d ? level2 + arrowGap : na, "R2 dn", shape.triangledown, location.absolute, color.red,  size = size.tiny)
plotshape(showArrows and f3u ? level3 - arrowGap : na, "R3 up", shape.triangleup,   location.absolute, color.lime, size = size.tiny)
plotshape(showArrows and f3d ? level3 + arrowGap : na, "R3 dn", shape.triangledown, location.absolute, color.red,  size = size.tiny)

// ---------------- Right-edge timeframe labels ----------------
var label lb1 = na
var label lb2 = na
var label lb3 = na
if barstate.islast
    label.delete(lb1)
    label.delete(lb2)
    label.delete(lb3)
    lb1 := label.new(bar_index + 2, level1, "TF " + useTF1, style = label.style_label_left, color = color.new(color.black, 100), textcolor = col(trend1), size = size.small)
    lb2 := label.new(bar_index + 2, level2, "TF " + useTF2, style = label.style_label_left, color = color.new(color.black, 100), textcolor = col(trend2), size = size.small)
    lb3 := label.new(bar_index + 2, level3, "TF " + useTF3, style = label.style_label_left, color = color.new(color.black, 100), textcolor = col(trend3), size = size.small)

// ---------------- Alerts (any row flips) ----------------
alertcondition(f1u or f2u or f3u, "Any row flip UP",   "An SMMA MTF row flipped GREEN")
alertcondition(f1d or f2d or f3d, "Any row flip DOWN", "An SMMA MTF row flipped RED")
